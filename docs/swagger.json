{
    "swagger": "2.0",
    "info": {
        "description": "Result Service.",
        "title": "Result Service",
        "contact": {},
        "version": "1.0.0"
    },
    "basePath": "/",
    "paths": {
        "/health": {
            "get": {
                "description": "Ping to check health",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Ping",
                "parameters": [
                    {
                        "type": "string",
                        "description": "user that make request",
                        "name": "X-User-Id",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "default": "web",
                        "description": "channel where request comes from",
                        "name": "X-Channel-Id",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "request unique identifier",
                        "name": "X-Request-Id",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "user account",
                        "name": "X-Account-Id",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.jsonResponse"
                        }
                    }
                }
            }
        },
        "/v1/admin/broadcast/live-results": {
            "post": {
                "description": "Manually trigger a broadcast of live results for testing or manual refresh (admin only)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Live Results Admin"
                ],
                "summary": "Trigger live results broadcast",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Election Pair ID to broadcast",
                        "name": "election_pair_id",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Broadcast triggered",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/controller.jsonResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "additionalProperties": true
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/v1/admin/cache/invalidate/all": {
            "post": {
                "description": "Invalidate all live results cache entries (admin only)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Live Results Admin"
                ],
                "summary": "Invalidate all cache",
                "responses": {
                    "200": {
                        "description": "All cache invalidated",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/controller.jsonResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "additionalProperties": true
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/v1/admin/cache/invalidate/city/{city_name}": {
            "post": {
                "description": "Invalidate cache entries for a specific city (admin only)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Live Results Admin"
                ],
                "summary": "Invalidate city cache",
                "parameters": [
                    {
                        "type": "string",
                        "description": "City Name",
                        "name": "city_name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cache invalidated",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/controller.jsonResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "additionalProperties": true
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/v1/admin/cache/invalidate/election/{election_pair_id}": {
            "post": {
                "description": "Invalidate all cache entries related to a specific election (admin only)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Live Results Admin"
                ],
                "summary": "Invalidate election cache",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Election Pair ID",
                        "name": "election_pair_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cache invalidated",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/controller.jsonResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "additionalProperties": true
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/v1/live/broadcast": {
            "post": {
                "description": "Manually trigger a broadcast of current results (for testing/admin purposes)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Live Results"
                ],
                "summary": "Trigger manual broadcast",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Election Pair ID to broadcast",
                        "name": "election_pair_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "City name for fast results broadcast",
                        "name": "city",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "default": "all",
                        "description": "Broadcast type: vote, election, region, statistics, all",
                        "name": "type",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Broadcast triggered",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/controller.jsonResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "additionalProperties": true
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/v1/live/cities/{city_name}": {
            "get": {
                "description": "Get real-time city voting results optimized for high performance using materialized views and Redis cache",
                "consumes": [
                    "application/json"
                ],
