                    {
                        "type": "boolean",
                        "default": true,
                        "description": "Include top cities data",
                        "name": "include_cities",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Limit number of cities returned",
                        "name": "cities_limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Fast live election results",
